# Image published by the CI
BOT_IMAGE=ghcr.io/your-github-user/archive-9-bot:latest

# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_GUILD_ID=000000000000000000
# Other AI bots on the server, comma separated
KNOWN_AI_BOT_IDS=
# Channels archived on first start; change them later with /config ecoute
LISTENED_CHANNEL_IDS=
# Category where bots may speak freely; elsewhere ARCHIVE-9 only answers
# an explicit @mention or a reply to its messages (unset: nowhere is free)
AGENTS_CATEGORY_ID=
# Names that count as a mention in that category, comma separated
BOT_ALIASES=ARCHIVE-9,ARCHIVE9,archive 9,A9
# Names that may also be a common word: the message goes to triage instead
BOT_SOFT_ALIASES=archive
BOT_TIMEZONE=Europe/Paris

# AI providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_PROVIDER_ORDER=baidu,deepinfra,alibaba
# Fallback chains, provider:model separated by commas (optional;
# comment them out rather than leaving them empty, an empty value stops the bot)
# AI_ROUTE_TRIAGE=groq:openai/gpt-oss-20b,openrouter:openrouter/free
# AI_ROUTE_REPLY=openrouter:deepseek/deepseek-v4.1-flash,groq:openai/gpt-oss-120b
# AI_ROUTE_ANALYSIS=openrouter:deepseek/deepseek-v4.1-flash
# AI_ROUTE_REFLECTION=openrouter:deepseek/deepseek-v4.1-flash
# AI_ROUTE_VISION=openrouter:deepseek/deepseek-v4.1-flash,groq:meta-llama/llama-4-scout-17b-16e-instruct
# Search index over fragments (needs the pgvector Postgres image)
# EMBEDDING_MODEL=baai/bge-m3

# Max spent on replies over 24 h, in USD; past it, only humans who mention
# or reply get an answer, from free models (optional)
# REPLY_DAILY_BUDGET_USD=1

# Learning (optional)
# Max spent on analysis over 24 h, in USD
# ANALYSIS_DAILY_BUDGET_USD=0.1
# VISION_DAILY_BUDGET_USD=0.1
# Voice channels: speech recognition (Groq Whisper) over 24 h, and the Piper service
# VOICE_DAILY_BUDGET_USD=0.2
# PIPER_URL=http://piper:5000
# Raw messages are deleted after this many days
# MESSAGE_RETENTION_DAYS=30

# Site, reached only through a Cloudflare Tunnel (the bot also puts this address in its bio).
# Reflection hours (midday and evening) are set on the site, in Réglages.
# WEB_IMAGE=ghcr.io/your-github-user/archive-9-web:latest
SITE_URL=https://archive.example.org
# Discord ID of the site's owner: always admin, names the other admins
SITE_OWNER_ID=000000000000000000
# Discord application > OAuth2; redirect: <SITE_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Site's database user, created by the bot (openssl rand -hex 24)
WEB_DB_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=

# Postgres (letters and digits only for the password, it goes into a URL)
POSTGRES_DB=archive9
POSTGRES_USER=archive9
POSTGRES_PASSWORD=change-me

# Backups
BACKUP_KEEP_DAYS=7

LOG_LEVEL=info

# Local development only
DATABASE_URL=postgres://archive9:change-me@localhost:5432/archive9
