# Image published by the CI
BOT_IMAGE=ghcr.io/your-github-user/archive-9-bot:latest

# Discord
DISCORD_TOKEN=your-bot-token
DISCORD_GUILD_ID=000000000000000000
# Other AI bots on the server, comma separated
KNOWN_AI_BOT_IDS=
# Channels archived on first start; change them later with /config ecoute
LISTENED_CHANNEL_IDS=
# Names that count as a mention, comma separated
BOT_ALIASES=ARCHIVE-9,ARCHIVE9,archive 9,A9
# Names that may also be a common word: the message goes to triage instead
BOT_SOFT_ALIASES=archive
BOT_TIMEZONE=Europe/Paris

# AI providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENROUTER_PROVIDER_ORDER=baidu,deepinfra,alibaba
# Fallback chains, provider:model separated by commas (optional;
# comment them out rather than leaving them empty, an empty value stops the bot)
# AI_ROUTE_TRIAGE=groq:openai/gpt-oss-20b,openrouter:openrouter/free
# AI_ROUTE_REPLY=openrouter:deepseek/deepseek-v4.1-flash,groq:openai/gpt-oss-120b
# AI_ROUTE_ANALYSIS=openrouter:deepseek/deepseek-v4.1-flash
# AI_ROUTE_REFLECTION=openrouter:deepseek/deepseek-v4.1-flash

# Learning (optional)
# Max spent on analysis over 24 h, in USD
# ANALYSIS_DAILY_BUDGET_USD=0.1
# Local hour of the daily reflection
# REFLECTION_HOUR=23
# Raw messages are deleted after this many days
# MESSAGE_RETENTION_DAYS=30

# Postgres (letters and digits only for the password, it goes into a URL)
POSTGRES_DB=archive9
POSTGRES_USER=archive9
POSTGRES_PASSWORD=change-me

# Backups
BACKUP_KEEP_DAYS=7

LOG_LEVEL=info

# Local development only
DATABASE_URL=postgres://archive9:change-me@localhost:5432/archive9
