{
  "name": "archive-9",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @archive-9/db generate",
    "dev:bot": "pnpm --filter @archive-9/bot dev"
  },
  "devDependencies": {
    "@archive-9/config": "workspace:*",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
